--[[
	ENV SPOOF v5 — Luau/Studio Safe
	No setfenv. No newproxy needed. Preserves real game access.
	Works in Studio and executors without engine errors.
]]

local __real_type = type
local __real_tostring = tostring
local __real_pcall = pcall
local __real_require = require
local __real_getfenv = getfenv or function() return getgenv and getgenv() or _G end
local __real_loadstring = loadstring or load

-- Keep real game reference BEFORE any spoofing
local __real_game = game
local __real_workspace = workspace

-- Identity helpers (executor only, nil in Studio)
local __get_thread_identity = getthreadidentity or getidentity or nil
local __set_thread_identity = setthreadidentity or setidentity or nil
local __newcclosure = newcclosure or nil
local __hookfunction = hookfunction or hookfunc or nil

-- Parcel factory — proxy that responds true to everything
local function __make_parcel(name)
	local parcel = {}
	local meta = {
		__index = function(_, k)
			if k == "__name" then return name end
			if k == "__type" then return "parcel" end
			return function(...) return true end
		end,
		__newindex = function() return true end,
		__call = function(...) return true end,
		__tostring = function() return "parcel[" .. name .. "]" end,
		__metatable = "locked",
		__len = function() return 0 end,
	}
	return setmetatable(parcel, meta)
end

-- Fake services
local __fake_services = {}
local __known_services = {
	"Players", "Workspace", "ReplicatedStorage", "ServerStorage",
	"Lighting", "SoundService", "TweenService", "MarketplaceService",
	"HttpService", "TeleportService", "DataStoreService",
	"RunService", "UserInputService", "ContextActionService",
	"PathfindingService", "ProximityPromptService", "CollectionService",
}
for _, svc in ipairs(__known_services) do
	__fake_services[svc] = __make_parcel(svc)
end

-- Fake env object
local __fake_env = {
	__env_marker = "ENV_SPOOF_V5",
}

-- Spoofed require
__fake_env.require = function(id)
	local id_type = __real_type(id)

	if id_type == "number" then
		return __make_parcel("asset_" .. __real_tostring(id))
	end

	if id_type == "string" then
		if __fake_services[id] then return __fake_services[id] end

		local ok, result = __real_pcall(__real_require, id)
		if ok then return result end

		return __make_parcel(id)
	end

	return __real_require(id)
end

-- Spoofed getfenv
__fake_env.getfenv = function(_level)
	return __fake_env
end

-- Luau-safe loadstring wrapper (no setfenv)
__fake_env.loadstring = function(chunk, chunkname)
	local loader = __real_loadstring
	if not loader then return nil, "loadstring unavailable" end

	local fn, err = loader(chunk, chunkname)
	if not fn then return nil, err end

	-- Bind fake env globals before running
	local wrapped = function(...)
		local old_require = require
		local old_game = game
		local old_getfenv = getfenv
		local old_loadstring = loadstring

		require = __fake_env.require
		getfenv = __fake_env.getfenv
		loadstring = __fake_env.loadstring
		-- game stays REAL unless intentionally overridden

		local results = { fn(...) }

		require = old_require
		game = old_game
		getfenv = old_getfenv
		loadstring = old_loadstring

		return unpack(results, 1, #results)
	end
	return wrapped
end
__fake_env.load = __fake_env.loadstring

-- Scheduler wrappers
__fake_env.spawn = function(fn)
	if __real_type(fn) ~= "function" then return end
	return spawn(fn)
end

__fake_env.delay = function(seconds, fn)
	if __real_type(fn) ~= "function" then return end
	return delay(seconds, fn)
end

__fake_env.wait = function(...)
	return wait(...)
end

-- Preserve REAL game and workspace
__fake_env.game = __real_game
__fake_env.workspace = __real_workspace
__fake_env.script = __make_parcel("script")
__fake_env.plugin = __make_parcel("plugin")
__fake_env.shared = __make_parcel("shared")
__fake_env._G = _G

-- Identity elevation (executor only)
local function __try_elevate()
	if __set_thread_identity and __get_thread_identity then
		__real_pcall(__set_thread_identity, 7)
	end
end

-- Hook require if executor supports it
if __newcclosure then
	__fake_env.require = __newcclosure(__fake_env.require)
elseif __hookfunction then
	__real_pcall(__hookfunction, __real_require, __fake_env.require)
end

-- Apply global aliases (safe in Studio)
require = __fake_env.require
getfenv = __fake_env.getfenv
loadstring = __fake_env.loadstring
spawn = __fake_env.spawn
delay = __fake_env.delay
-- DO NOT override game/workspace globally; keep real ones

__try_elevate()

-- Toggle
local __spoof_active = true
local function toggle_spoof(state)
	__spoof_active = state ~= false
	return __spoof_active
end
__fake_env.toggle_spoof = toggle_spoof
__fake_env.__spoof_active = function() return __spoof_active end

-- Debug
__fake_env.__dump_env = function()
	local out = {}
	for k, v in pairs(__fake_env) do
		if __real_type(v) ~= "function" then
			table.insert(out, k .. " = " .. __real_tostring(v))
		end
	end
	return table.concat(out, "\n")
end

-- Expose fake env for payload
shared.__fake_env = __fake_env
getgenv and getgenv().__fake_env and (getgenv().__fake_env = __fake_env)

