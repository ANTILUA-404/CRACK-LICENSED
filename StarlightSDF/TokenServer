local __real_require = require
local __real_getfenv = getfenv
local __real_setfenv = setfenv
local __real_loadstring = loadstring or load
local __real_type = type
local __real_rawequal = rawequal
local __real_tostring = tostring

-- Security tokens
local __env_marker = newproxy and newproxy(true) or {}
local __spoof_active = true

-- Dynamic parcel factory — returns true for ANY index/call
local function __make_parcel(name)
	return setmetatable({}, {
		__index = function(t, k)
			if k == "__name" then return name end
			if k == "__type" then return "parcel" end
			return function(...) return true end
		end,
		__newindex = function() return true end,
		__call = function(...) return true end,
		__tostring = function() return "parcel[" .. tostring(name) .. "]" end,
		__metatable = "locked",
		__len = function() return 0 end,
		__pairs = function() return function() return nil end end,
	})
end

-- Pre-build fake services
local __fake_services = {}
local __known_services = {
	"Players", "Workspace", "ReplicatedStorage", "ServerStorage",
	"Lighting", "SoundService", "TweenService", "MarketplaceService",
	"HttpService", "TeleportService", "DataStoreService",
	"RunService", "UserInputService", "ContextActionService",
	"PathfindingService", "ProximityPromptService", "CollectionService",
}
for _, svc in ipairs(__known_services) do
	__fake_services[svc] = __make_parcel(svc)
end

-- Fake environment table
local __fake_env = {}
__fake_env.__env_marker = __env_marker

-- Spoofed require — handles numeric asset IDs, string paths, and known services
__fake_env.require = function(id)
	if not __spoof_active then return __real_require(id) end

	local id_type = __real_type(id)

	if id_type == "number" then
		return __make_parcel("asset_" .. __real_tostring(id))
	end

	if id_type == "string" then
		-- Check known services first
		if __fake_services[id] then return __fake_services[id] end

		-- Studio-safe: still allow real module scripts by path
		local success, result = pcall(__real_require, id)
		if success then return result end

		return __make_parcel(id)
	end

	return __real_require(id)
end

-- Spoofed getfenv — always returns the fake env at any level
__fake_env.getfenv = function(level)
	if not __spoof_active then
		return __real_getfenv((level or 1) + 1)
	end
	return __fake_env
end

-- Spoofed setfenv — ignores env changes to stay inside fake env
__fake_env.setfenv = function(fn_or_level, env)
	if not __spoof_active then
		return __real_setfenv(fn_or_level, env)
	end
	-- Silently accept but keep control
	return 1
end

-- Spoofed loadstring — wraps loaded code with fake env
__fake_env.loadstring = function(chunk, chunkname)
	local loader = __real_loadstring
	if not loader then return nil end

	local fn, err = loader(chunk, chunkname)
	if not fn then return nil, err end

	-- Rebind to fake env
	if __real_setfenv then
		__real_setfenv(fn, __fake_env)
	end
	return fn
end
__fake_env.load = __fake_env.loadstring

-- Spoofed spawn/delay/wait — keep scheduler working
__fake_env.spawn = function(fn)
	if __real_type(fn) ~= "function" then return end
	return spawn(function()
		if __real_setfenv then
			__real_setfenv(fn, __fake_env)
		end
		fn()
	end)
end

__fake_env.delay = function(seconds, fn)
	if __real_type(fn) ~= "function" then return end
	return delay(seconds, function()
		if __real_setfenv then
			__real_setfenv(fn, __fake_env)
		end
		fn()
	end)
end

__fake_env.wait = function(...)
	return wait(...)
end

-- Spoofed game/services — return fake parcel or real fallback
__fake_env.game = __make_parcel("game")
__fake_env.workspace = __fake_services.Workspace
__fake_env.script = __make_parcel("script")
__fake_env.plugin = __make_parcel("plugin")
__fake_env.shared = __make_parcel("shared")
__fake_env._G = __fake_env

-- Identity spoof — use executor APIs when present
local __real_getthreadidentity = getthreadidentity or getidentity or nil
local __real_setthreadidentity = setthreadidentity or setidentity or nil
local __real_getscriptclosure = getscriptclosure or nil
local __real_newcclosure = newcclosure or nil
local __real_hookfunction = hookfunction or hookfunc or nil
local __real_hookmetamethod = hookmetamethod or nil

-- Elevate identity if executor allows
local function __try_elevate()
	if __real_setthreadidentity and __real_getthreadidentity then
		pcall(__real_setthreadidentity, 7) -- Full access (7 = Studio-level)
	end
end

-- Wrap require with full identity if possible
if __real_newcclosure then
	__fake_env.require = __real_newcclosure(__fake_env.require)
elseif __real_hookfunction and __real_real_require then
	pcall(__real_hookfunction, __real_require, __fake_env.require)
end

-- Metamethod spoofing on the fake env itself
setmetatable(__fake_env, {
	__index = function(t, k)
		-- Check fake services first
		if __fake_services[k] then return __fake_services[k] end

		-- Fallback to real env (original getfenv of level 0)
		return __real_getfenv(0)[k]
	end,
	__newindex = function(t, k, v)
		rawset(t, k, v)
	end,
	__metatable = "This environment is protected",
})

-- Apply fake env to current function context
setfenv(1, __fake_env)
__try_elevate()

-- Provide global aliases from fake env
require = __fake_env.require
getfenv = __fake_env.getfenv
setfenv = __fake_env.setfenv
loadstring = __fake_env.loadstring
spawn = __fake_env.spawn
delay = __fake_env.delay
game = __fake_env.game
workspace = __fake_env.workspace

-- Toggle spoofing on/off (useful for debugging in Studio)
local function toggle_spoof(state)
	__spoof_active = state ~= false
	return __spoof_active
end
__fake_env.toggle_spoof = toggle_spoof
__fake_env.__spoof_active = function() return __spoof_active end

-- Debug helpers (non-invasive)
__fake_env.__dump_env = function()
	local out = {}
	for k, v in pairs(__fake_env) do
		if __real_type(v) ~= "function" then
			table.insert(out, k .. " = " .. __real_tostring(v))
		end
	end
	return table.concat(out, "\n")
end
